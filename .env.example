# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32

# Public HTTPS URL your reverse proxy / tunnel serves this app on (no trailing slash).
# Used for feed and enclosure links, so it must be reachable by Apple Podcasts.
PUBLIC_URL=https://podcasts.example.com

# Password for the web UI (12+ characters).
ADMIN_PASSWORD=

# Signs session cookies (32+ characters). Changing it signs everyone out.
SESSION_SECRET=

# Password for the bundled MongoDB. Hex only, since it goes into a URI.
MONGO_PASSWORD=

# Host port and interface for the app. 127.0.0.1 keeps it reachable only from this
# machine (e.g. Caddy or cloudflared on the host). Use 0.0.0.0 if your proxy runs elsewhere.
PORT=3000
BIND_ADDRESS=127.0.0.1

# Set to true ONLY when a reverse proxy sits in front and sets X-Forwarded-For.
# Enables per-client rate limiting; leaving it false means one shared limit.
TRUST_PROXY=false

# --- Optional -----------------------------------------------------------------
# MAX_DURATION_MINUTES=240        # reject longer videos
# AUDIO_QUALITY=128K              # MP3 bitrate (e.g. 96K) or VBR level 0-10
# SESSION_TTL_HOURS=336
# INGEST_RATE_LIMIT_PER_MINUTE=20
# LOGIN_RATE_LIMIT_PER_15_MINUTES=10
# YTDLP_AUTO_UPDATE=true          # runs `yt-dlp -U` at start and daily
# YTDLP_VERSION=latest            # pin a yt-dlp release at build time, e.g. 2026.10.20
# YTDLP_COOKIES_FILE=/data/cookies.txt  # Netscape cookies if YouTube asks you to sign in
